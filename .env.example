# Application Configuration
APP_NAME=LinkPlease
DEBUG=false
HOST=0.0.0.0
PORT=8000

# Database Configuration (PostgreSQL with asyncpg driver, or SQLite for local dev/testing)
# Example PostgreSQL: postgresql+asyncpg://postgres:postgres@localhost:5432/linkplease
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/linkplease

# PseudoGram Mock API Configuration
PSEUDOGRAM_BASE_URL=https://pseudogram-api.onrender.com
PSEUDOGRAM_API_KEY=your_pseudogram_api_key_here

# Webhook Security
WEBHOOK_SECRET=your_hmac_webhook_secret_here

# Rate Limiter Settings
DM_SEND_RATE_LIMIT=10
DM_SEND_RATE_WINDOW_SECONDS=60
